NODE_ENV=development
PORT=4000

# Self-hosted PostgreSQL (docker-compose.yml locally, the VPS's own compose.yml
# in production) — no connection pooler, so DATABASE_URL and DIRECT_URL are the
# same connection. Host is "localhost" (port from docker-compose.yml) outside
# Docker, or the "postgres" service name when running inside the same Compose
# network (as the api container does in production).
DATABASE_URL=postgresql://kahawatrade:YOUR_DB_PASSWORD@localhost:5434/kahawatrade_dev
DIRECT_URL=postgresql://kahawatrade:YOUR_DB_PASSWORD@localhost:5434/kahawatrade_dev
# No TLS between the api container and the postgres container on the same
# internal Docker network. Only set DB_SSL_MODE=require (and configure
# DB_SSL_REJECT_UNAUTHORIZED / DB_SSL_CA_PATH) if pointing at a managed/remote
# Postgres provider that requires TLS.
DB_SSL_MODE=disable

REQUEST_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=15
IDEMPOTENCY_ENABLED=false
IDEMPOTENCY_REQUIRE_KEY=false
IDEMPOTENCY_TTL_SECONDS=86400

# At least 32 characters each
JWT_ACCESS_SECRET=CHANGE_ME_SUPER_LONG_ACCESS_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_SUPER_LONG_REFRESH_SECRET_32_CHARS_MIN
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SUPER_ADMIN_JWT_SECRET=CHANGE_ME_SUPER_LONG_SUPER_ADMIN_SECRET_32_CHARS_MIN
SUPER_ADMIN_JWT_TTL=8h
SUPER_ADMIN_BOOTSTRAP_EMAIL=superadmin@kahawatrade.test
SUPER_ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!12345

# Base64-encoded 32-byte key (example generation):
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# At least 32 characters
CSRF_SECRET=CHANGE_ME_SUPER_LONG_CSRF_SECRET_32_CHARS_MIN

LOG_LEVEL=info

# Notifications (email only)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
NOTIFICATION_FROM_EMAIL=system@yourdomain.com
NOTIFICATION_ADMIN_EMAILS=admin@yourdomain.com,ops@yourdomain.com
NOTIFICATIONS_CRON_ENABLED=true
NOTIFICATIONS_CRON_TIMEZONE=UTC
CONTRACT_RISK_CRON_SCHEDULE=0 7 * * *
CONTRACT_RISK_ALERT_WINDOW_DAYS=7
API_KEY_EXPIRY_CRON_SCHEDULE=15 7 * * *
API_KEY_EXPIRY_ALERT_WINDOW_DAYS=7

# Manual VPS redeploy (see README "Production deploy runbook") — deployment
# is manual, not automated via GitHub Actions. Set on the VPS shell, not here.
VPS_API_DIR=/opt/kahawatrade/api
API_IMAGE=ghcr.io/rodgersbry/kahawatrade-api:latest
